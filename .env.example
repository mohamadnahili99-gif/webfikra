# WEBFIKRA restaurant platform - copy these values into Vercel Environment Variables.
# Do not commit real keys/passwords.
SUPABASE_URL=
# Supabase publishable key (sb_publishable_...) or legacy anon key; NEVER service_role
SUPABASE_PUBLISHABLE_KEY=
# Enable only once RLS migration, email verification and anti-abuse controls are ready
WEBFIKRA_ALLOW_SIGNUPS=false
# Optional
NEXT_PUBLIC_SITE_URL=https://webfikra.com
